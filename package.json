{
  "name": "spark",
  "version": "0.1.4",
  "description": "AI Content Discovery for Creators",
  "type": "module",
  "main": "dist/desktop/main.js",
  "scripts": {
    "build": "tsc && npm run build:css && npm run copy-files",
    "build:css": "tailwindcss -i assets/tailwind-input.css -o assets/tailwind.css --content \"./src/web/**/*.{ts,html}\" --minify",
    "copy-files": "node scripts/copy-files.mjs",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "desktop": "npm run build && electron dist/desktop/main.js",
    "desktop:pack": "node scripts/package-desktop.mjs --dir",
    "desktop:dist": "node scripts/package-desktop.mjs",
    "desktop:dist:mac": "node scripts/package-desktop.mjs --mac",
    "desktop:dist:win": "node scripts/package-desktop.mjs --win",
    "desktop:dist:linux": "node scripts/package-desktop.mjs --linux",
    "desktop:rebuild": "electron-builder install-app-deps",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:init": "tsx src/db/init.ts",
    "admin": "tsx src/web/admin-server.ts",
    "worker": "tsx src/runtime/worker.ts",
    "test:aggregator": "tsx src/test-aggregator.ts",
    "test:filter": "tsx src/test-filter.ts",
    "test:generator": "tsx src/test-generator-feishu.ts",
    "workflow": "tsx src/workflow.ts"
  },
  "keywords": [
    "x",
    "twitter",
    "content",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fusae/Spark.git"
  },
  "build": {
    "appId": "io.github.fusae.spark",
    "productName": "Spark",
    "icon": "assets/spark-icon.png",
    "asar": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fusae",
        "repo": "Spark",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "icon": "assets/spark-icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "assets/spark-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spark"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.66.1",
    "@lucasygu/redbook": "^0.7.2",
    "axios": "^1.16.1",
    "better-sqlite3": "^9.4.0",
    "dotenv": "^16.4.0",
    "electron-updater": "^6.8.3",
    "node-cron": "^4.2.1",
    "openai": "^4.28.0",
    "p-limit": "^5.0.0",
    "puppeteer": "^22.15.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "electron": "^30.5.1",
    "electron-builder": "^26.8.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "axios": "^1.16.1",
    "protobufjs": "^8.5.0",
    "qs": "^6.15.2",
    "ws": "^8.21.0"
  }
}
